# ── Database (PostgreSQL) ───────────────────────────────────────────────
# Local example: createdb lingua && createuser lingua
DATABASE_URL="postgresql://lingua:lingua@localhost:5432/lingua?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────
# Secret used to sign session cookies (JWT HS256). Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-with-a-long-random-string-at-least-32-chars"
# Public base URL of the app (used in password-reset links)
APP_URL="http://localhost:3000"

# ── AI teacher (server-side only — never exposed to the browser) ────────
# Get a key at https://console.anthropic.com/ . Without a key the app runs in
# MOCK mode (rule-based corrections & canned conversation, clearly labelled in the UI).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Optional: override the API base URL (proxy / gateway)
ANTHROPIC_BASE_URL="https://api.anthropic.com"
# Force mock mode even if a key is present (true/false)
AI_FORCE_MOCK="false"

# ── Password reset e-mail (optional) ────────────────────────────────────
# If RESEND_API_KEY is empty the reset link is printed in the server logs
# (and returned in the API response when NODE_ENV != production).
RESEND_API_KEY=""
EMAIL_FROM="Lingua <no-reply@example.com>"

# ── Rate limiting (per instance, in memory) ─────────────────────────────
RATE_LIMIT_AI_PER_MIN="20"
RATE_LIMIT_AUTH_PER_MIN="10"
